# Core
DEBUG=true
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend runtime
LOG_LEVEL=INFO
LOG_DIR=./logs

# Database
DATABASE_URL=sqlite+aiosqlite:///./backend/data/crawler_tasks.db
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/crawler_db
POSTGRES_USER=crawler_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=crawler_db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_CELERY=false

# Admin bootstrap (used by create_admin.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Firecrawl
FIRECRAWL_API_KEY=CHANGE_ME
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Task recycle
TASK_RECYCLE_INTERVAL_SECONDS=300
TASK_RUNNING_TIMEOUT_SECONDS=1800

# Frontend runtime
# Example:
# VITE_API_BASE_URL=https://your-backend-domain/api
# VITE_WS_BASE_URL=wss://your-backend-domain
# VITE_DEMO_MODE=true enables mock APIs for frontend-only demos.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
VITE_DEMO_MODE=false
